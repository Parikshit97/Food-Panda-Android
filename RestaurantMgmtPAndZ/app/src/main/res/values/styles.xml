<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="AppThemeBase" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ui_canvas</item>
        <item name="android:statusBarColor">#531A36</item>
        <item name="android:navigationBarColor">#531A36</item>
        <item name="android:colorControlActivated">@color/ui_pink</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Brand" parent="Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/ui_pink</item>
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>
    <style name="Section" parent="Title">
        <item name="android:textSize">21sp</item>
    </style>
    <style name="Label" parent="Body">
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/ui_input</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textColorHint">@color/ui_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/ui_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/ui_secondary</item>
        <item name="android:textColor">@color/ui_pink</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>