<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ui_canvas" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/SecondaryButton" android:text="@string/ui_17" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:textSize="28sp" android:contentDescription="@string/ui_16" android:layout_marginEnd="14dp" android:onClick="navigateBack" />
            <TextView style="@style/Brand" android:text="@string/ui_7" android:layout_gravity="center_vertical" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <TextView style="@style/Title" android:text="@string/ui_78" />
        <Space android:layout_width="1dp" android:layout_height="8dp" />
        <TextView style="@style/Body" android:text="@string/ui_79" />
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="22dp" android:background="@drawable/ui_hero">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Title" android:text="KFC" android:textColor="#FFFFFF" />
                <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/ui_kfc_hero" android:textColor="#F5D5E2" />
            </LinearLayout>
            <ImageView android:layout_width="100dp" android:layout_height="110dp" android:src="@drawable/ui_food" android:importantForAccessibility="no" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp">
            <TextView style="@style/Section" android:text="@string/ui_65" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:text="@string/ui_62" android:id="@+id/vegrb" android:onClick="generateMenu" android:layout_width="wrap_content" android:layout_height="48dp" android:textColor="@color/ui_ink" android:textSize="13sp" />
                <RadioButton android:text="@string/ui_63" android:id="@+id/nonvegrb" android:onClick="generateMenu" android:layout_width="wrap_content" android:layout_height="48dp" android:textColor="@color/ui_ink" android:textSize="13sp" />
                <RadioButton android:text="@string/ui_64" android:id="@+id/beverage" android:onClick="generateMenu" android:layout_width="wrap_content" android:layout_height="48dp" android:textColor="@color/ui_ink" android:textSize="13sp" />
            </RadioGroup>
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <Spinner android:id="@+id/spinner1" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/ui_input" android:contentDescription="@string/ui_66" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView style="@style/Label" android:text="@string/ui_67" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView style="@style/Body" android:id="@+id/etorder" android:text="@string/ui_68" android:padding="16dp" android:background="@drawable/ui_soft" android:textIsSelectable="true" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView style="@style/Label" android:text="@string/ui_70" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText style="@style/Field" android:id="@+id/etqty" android:hint="@string/ui_69" android:inputType="number" android:text="1" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <TextView style="@style/Label" android:text="@string/ui_71" />
            <TextView style="@style/Title" android:id="@+id/ettotal" android:text="@string/ui_72" android:textColor="@color/ui_pink" />
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <TextView style="@style/Label" android:text="@string/ui_73" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView style="@style/Body" android:id="@+id/etdate" android:text="@string/ui_74" android:padding="16dp" android:background="@drawable/ui_soft" android:textIsSelectable="true" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <Button style="@style/SecondaryButton" android:text="@string/ui_75" android:id="@+id/datetimepicker" android:onClick="onButtonClick" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <Button style="@style/PrimaryButton" android:text="@string/ui_76" android:id="@+id/addcartbutton" android:onClick="addToCart" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <Button style="@style/SecondaryButton" android:text="@string/ui_77" android:id="@+id/viewcartbutton" android:onClick="viewCart" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="28dp" />
    </LinearLayout>
</ScrollView>