<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ui_canvas" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/Brand" android:text="@string/ui_7" android:layout_gravity="center_vertical" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <TextView style="@style/Title" android:text="@string/ui_41" />
        <Space android:layout_width="1dp" android:layout_height="8dp" />
        <TextView style="@style/Body" android:text="@string/ui_42" />
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="22dp" android:background="@drawable/ui_hero" android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView style="@style/Label" android:text="@string/ui_31" android:textColor="#F6B7CE" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <TextView style="@style/Title" android:text="@string/ui_32" android:textColor="#FFFFFF" android:textSize="26sp" />
                <Space android:layout_width="1dp" android:layout_height="10dp" />
                <TextView style="@style/Body" android:text="@string/ui_33" android:textColor="#F5D5E2" />
            </LinearLayout>
            <ImageView android:layout_width="115dp" android:layout_height="150dp" android:src="@drawable/ui_food" android:importantForAccessibility="no" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="28dp" />
        <TextView style="@style/Section" android:text="@string/ui_40" />
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/SecondaryButton" android:text="@string/ui_34" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_bag" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="12dp" android:id="@+id/buttonOrder" android:onClick="takeOrder" />
            <Button style="@style/SecondaryButton" android:text="@string/ui_35" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_plate" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="0dp" android:id="@+id/buttonRestaurant" android:onClick="openrestaurants" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/SecondaryButton" android:text="@string/ui_36" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_calendar" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="12dp" android:id="@+id/buttonBook" android:onClick="booktablehall" />
            <Button style="@style/SecondaryButton" android:text="@string/ui_37" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_gift" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="0dp" android:id="@+id/buttonOffers" android:onClick="offerview" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/SecondaryButton" android:text="@string/ui_38" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_heart" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="12dp" android:id="@+id/buttonFeedback" android:onClick="takefeedback" />
            <Button style="@style/SecondaryButton" android:text="@string/ui_39" android:layout_width="0dp" android:layout_weight="1" android:layout_height="132dp" android:background="@drawable/ui_card" android:textColor="@color/ui_ink" android:drawableTop="@drawable/ui_icon_chat" android:drawablePadding="14dp" android:gravity="center" android:layout_marginEnd="0dp" android:id="@+id/buttonContactUs" android:onClick="dialogopen" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <Space android:layout_width="1dp" android:layout_height="28dp" />
    </LinearLayout>
</ScrollView>