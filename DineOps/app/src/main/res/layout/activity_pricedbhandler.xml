<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ui_canvas" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/SecondaryButton" android:text="@string/ui_17" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:textSize="28sp" android:contentDescription="@string/ui_16" android:layout_marginEnd="14dp" android:onClick="navigateBack" />
            <TextView style="@style/Brand" android:text="@string/ui_7" android:layout_gravity="center_vertical" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <TextView style="@style/Title" android:text="@string/ui_119" />
        <Space android:layout_width="1dp" android:layout_height="8dp" />
        <TextView style="@style/Body" android:text="@string/ui_120" />
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp">
            <TextView style="@style/Label" android:text="@string/ui_113" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText style="@style/Field" android:id="@+id/etname" android:hint="@string/ui_113" android:inputType="textCapWords" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <TextView style="@style/Label" android:text="@string/ui_117" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText style="@style/Field" android:id="@+id/etitem" android:hint="@string/ui_117" android:inputType="textCapWords" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <TextView style="@style/Label" android:text="@string/ui_118" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText style="@style/Field" android:id="@+id/etprice" android:hint="@string/ui_118" android:inputType="numberDecimal" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button style="@style/PrimaryButton" android:text="@string/ui_105" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:id="@+id/buttonInsert" android:onClick="insertClick" />
                <Button style="@style/SecondaryButton" android:text="@string/ui_106" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:id="@+id/buttonUpdate" android:onClick="updateClick" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button style="@style/SecondaryButton" android:text="@string/ui_107" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:id="@+id/buttonDelete" android:onClick="deleteClick" />
                <Button style="@style/SecondaryButton" android:text="@string/ui_108" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:id="@+id/buttonView" android:onClick="viewClick" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="10dp" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <TextView style="@style/Section" android:text="@string/ui_109" />
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <TextView style="@style/Body" android:id="@+id/tv1" android:text="@string/ui_110" android:padding="16dp" android:background="@drawable/ui_soft" android:textIsSelectable="true" />
        <Space android:layout_width="1dp" android:layout_height="28dp" />
    </LinearLayout>
</ScrollView>